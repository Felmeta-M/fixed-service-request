# Git
.git
.gitignore
.gitattributes

# IDE and editors
.idea
.vscode
.fleet
.nova
.zed
*.swp
*.swo
.phpstorm.meta.php
.phpactor.json

# Environment (never bake into image; use env_file at runtime)
.env
.env.*
.env.backup
.env.production
.env.staging
.env.local
.env.testing

# Dependencies (rebuilt in container)
/node_modules
/vendor
.pnpm-store
.pnpm-debug.log
npm-debug.log
yarn-error.log

# Build artifacts (rebuilt in container)
/public/build
/public/hot
/public/storage
/bootstrap/ssr
/bootstrap/cache/*.php
!/bootstrap/cache/.gitignore

# Storage (runtime data; use volumes in production)
/storage/*.key
/storage/pail
/storage/debugbar
/storage/framework/cache/data
/storage/framework/sessions
/storage/framework/views
/storage/logs
/storage/oauth-private.key
/storage/oauth-public.key
/storage/app/public
/storage/app/debugbar
/storage/app/pail
/storage/temp
/storage/backups
/storage/imports
/storage/exports
/storage/media

# Testing (not needed in image)
/tests
.phpunit.cache
.phpunit.result.cache
/coverage.xml
phpunit.xml

# Static analysis / code style (not needed in image)
/phpstan.neon
/phpstan-baseline.neon
.php-cs-fixer.cache
pint.json

# Documentation (optional: remove to include in image)
*.md
/docs

# Database dumps and large data (use volumes)
*.sql
*.gz
/database/*.csv

# Compose and Docker meta (not needed inside image)
docker-compose*.yml
compose*.yml
compose-*.yml
Dockerfile*
.dockerignore

# Host scripts (keep docker/php/*.sh for entrypoint)
/scripts
database_backup.sh
laravel_backup.sh
mirror_backup.sh
/fixed-services-config

# Misc
.DS_Store
Thumbs.db
*.log
/http
/_ide_helper.php
/auth.json
Homestead.json
Homestead.yaml

# Frontend tooling (not needed at runtime)
.prettierrc
.prettierignore
.editorconfig
eslint.config.js
tsconfig.json
vite.config.ts
components.json
pnpm-workspace.yaml

# Other frameworks (unused)
.next
.vercel
.vercel_build_output
.output
.svelte-kit
.nuxt
.astro
.turbo
