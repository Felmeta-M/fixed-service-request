# Git
.git
.gitignore
.gitattributes

# IDE and editors
.idea
.vscode
.fleet
.nova
.zed
*.swp
*.swo
.phpstorm.meta.php
.phpactor.json

# Environment files (sensitive)
.env
.env.*
!.env.production
!.env.staging

# Node.js
node_modules
.pnpm-store
.pnpm-debug.log
npm-debug.log
yarn-error.log

# Build artifacts (rebuilt in container)
/vendor
/public/build
/public/hot
/public/storage
/bootstrap/ssr
/bootstrap/cache/*.php

# Storage (application runtime data)
/storage/*.key
/storage/pail
/storage/debugbar
/storage/framework/cache/data
/storage/framework/sessions
/storage/framework/views
/storage/logs
/storage/oauth-private.key
/storage/oauth-public.key
/storage/app/public
/storage/app/debugbar
/storage/app/pail
/storage/temp
/storage/backups
/storage/imports
/storage/exports
/storage/media

# Testing
/tests
/.phpunit.cache
.phpunit.result.cache
/coverage.xml
phpunit.xml

# Static analysis and code style
/phpstan.neon
/phpstan-baseline.neon
/.php-cs-fixer.cache
pint.json

# Documentation
*.md
/docs

# Database dumps and backups
*.sql
*.gz
/database/*.csv

# Docker files (avoid recursive context)
docker-compose*.yml
compose*.yml
Dockerfile*

# Scripts not needed in container
/scripts
*.sh

# Misc
.DS_Store
Thumbs.db
*.log
/http
/_ide_helper.php
/auth.json
Homestead.json
Homestead.yaml

# Frontend build tools config (not needed at runtime)
.prettierrc
.prettierignore
.editorconfig
eslint.config.js
tsconfig.json
vite.config.ts
components.json
pnpm-workspace.yaml

# Other framework artifacts
.next
.vercel
.vercel_build_output
.output
.svelte-kit
.nuxt
.astro
.turbo
