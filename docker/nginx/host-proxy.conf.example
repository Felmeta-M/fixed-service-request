# Host nginx: reverse proxy to Docker nginx (fixed-service-request)
# Copy to /etc/nginx/sites-available/fixedservices.conf and:
#   sudo ln -s /etc/nginx/sites-available/fixedservices.conf /etc/nginx/sites-enabled/
#   sudo nginx -t && sudo systemctl reload nginx
#
# Replace /path/to/ with your real certificate and key paths.
# Docker nginx must be listening on 127.0.0.1:9991 (compose.yml: "9991:80").

# HTTP – redirect to HTTPS
server {
    listen 80;
    server_name fixedservices.ethiotelecom.et;

    location / {
        return 301 https://$host$request_uri;
    }
}

# HTTPS – SSL on host, proxy to Docker nginx
server {
    listen 443 ssl http2;
    server_name fixedservices.ethiotelecom.et;

    ssl_certificate     /path/to/server.crt;
    ssl_certificate_key /path/to/server.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers on;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384;

    location / {
        proxy_pass http://127.0.0.1:9991;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffer_size 128k;
        proxy_buffers 4 256k;
        proxy_busy_buffers_size 256k;
        large_client_header_buffers 4 64k;
    }
}
