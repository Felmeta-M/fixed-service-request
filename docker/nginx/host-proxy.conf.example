# ============================================================================
# Host-Level Reverse Proxy — Ethio Telecom Fixed Service Request
# ============================================================================
#
# This config runs on the HOST machine's Nginx (not inside Docker).
# It terminates SSL/TLS and proxies traffic to the Docker Nginx container.
#
# Traffic flow:
#   Client (HTTPS :443) -> Host Nginx (this config) -> Docker Nginx (:9991) -> PHP-FPM
#
# Setup:
#   1. Copy this file to /etc/nginx/sites-available/fixedservices.conf
#   2. Create a symlink:
#        sudo ln -s /etc/nginx/sites-available/fixedservices.conf /etc/nginx/sites-enabled/
#   3. Replace /path/to/ with your real SSL certificate and key paths
#   4. Ensure Docker Nginx is mapped to 127.0.0.1:9991 in docker-compose.yml:
#        ports:
#          - "127.0.0.1:9991:80"
#   5. Test and reload:
#        sudo nginx -t && sudo systemctl reload nginx
# ============================================================================


# ---------------------------------------------------------------------------
# HTTP Server — Redirect to HTTPS
# ---------------------------------------------------------------------------
# All plain HTTP requests are permanently redirected (301) to HTTPS.
# This ensures all traffic is encrypted in transit.
# ---------------------------------------------------------------------------
server {
    listen 80;
    server_name fixedservices.ethiotelecom.et;

    location / {
        return 301 https://$host$request_uri;
    }
}


# ---------------------------------------------------------------------------
# HTTPS Server — SSL Termination + Reverse Proxy
# ---------------------------------------------------------------------------
# Handles TLS handshake, decrypts traffic, then forwards plain HTTP to
# the Docker Nginx container on port 9991 (localhost only, not exposed
# to the network).
# ---------------------------------------------------------------------------
server {
    listen 443 ssl http2;
    server_name fixedservices.ethiotelecom.et;

    # -------------------------------------------------------------------
    # SSL Certificate
    # -------------------------------------------------------------------
    # Replace these paths with your actual certificate and private key.
    # For Let's Encrypt: /etc/letsencrypt/live/fixedservices.ethiotelecom.et/
    # -------------------------------------------------------------------
    ssl_certificate     /path/to/server.crt;
    ssl_certificate_key /path/to/server.key;

    # -------------------------------------------------------------------
    # TLS Protocol & Cipher Configuration
    # -------------------------------------------------------------------
    # - Only TLSv1.2 and TLSv1.3 (TLSv1.0/1.1 are deprecated/insecure)
    # - Server chooses the cipher (prefer_server_ciphers), not the client
    # - Strong AEAD ciphers only (AES-GCM with ECDHE key exchange)
    # -------------------------------------------------------------------
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers on;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384;

    # -------------------------------------------------------------------
    # Reverse Proxy to Docker Nginx
    # -------------------------------------------------------------------
    # proxy_pass:
    #   Forwards decrypted traffic to Docker Nginx on localhost:9991.
    #   The Docker container's port 80 is mapped to host port 9991.
    #
    # proxy_http_version 1.1:
    #   Uses HTTP/1.1 for the backend connection (required for keepalive).
    #
    # Proxy Headers (critical for Laravel):
    #   - Host:              Preserves the original hostname so Laravel
    #                        generates correct URLs.
    #   - X-Real-IP:         The actual client IP (for logging/rate limiting).
    #   - X-Forwarded-For:   Chain of proxy IPs the request passed through.
    #                        Laravel uses this via trustProxies to get the
    #                        real client IP from request()->ip().
    #   - X-Forwarded-Proto: The original protocol (https). This is CRITICAL
    #                        for Laravel's signed URL validation, asset URL
    #                        generation, and secure cookie handling. Without
    #                        this, Laravel thinks the request is HTTP and
    #                        signed URLs fail with 403 "Invalid signature".
    #
    # Buffer Settings:
    #   Large buffers to handle Filament/Livewire responses which can
    #   contain substantial HTML/JSON payloads and large headers
    #   (session cookies, CSRF tokens, Livewire snapshots).
    #
    # Content-Security-Policy (required for reCAPTCHA + Maps):
    #   If this proxy sets CSP, it MUST include script-src and frame-src for
    #   Google reCAPTCHA (trouble ticket / complaint form). Use the policy
    #   below. If you already have add_header Content-Security-Policy
    #   elsewhere, replace it with this full policy or add the missing
    #   sources: https://www.google.com https://www.gstatic.com
    #   https://www.recaptcha.net (script + frame).
    #   To avoid duplicate CSP, strip backend CSP and set only here:
    #   proxy_hide_header Content-Security-Policy;
    # -------------------------------------------------------------------
    location / {
        proxy_pass http://127.0.0.1:9991;
        proxy_http_version 1.1;

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_buffer_size 128k;
        proxy_buffers 4 256k;
        proxy_busy_buffers_size 256k;
        large_client_header_buffers 4 64k;

        # Optional: use proxy as single source of CSP (strip backend, set here)
        proxy_hide_header Content-Security-Policy;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://cdn.jsdelivr.net https://maps.googleapis.com https://www.google.com https://www.gstatic.com https://www.recaptcha.net; script-src-elem 'self' 'unsafe-inline' 'unsafe-eval' https://cdn.jsdelivr.net https://maps.googleapis.com https://www.google.com https://www.gstatic.com https://www.recaptcha.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: https: blob:; connect-src 'self' https:; frame-src 'self' https://www.google.com https://www.recaptcha.net; frame-ancestors 'self'; form-action 'self'; base-uri 'self'; object-src 'none';" always;
   
    }
}
