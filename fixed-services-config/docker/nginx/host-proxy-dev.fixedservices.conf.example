# ============================================================================
# Host Nginx — dev.fixedservices.ethiotelecom.et (Staging only)
# ============================================================================
#
# PURPOSE:
#   Expose staging over HTTPS so Telebirr can call NOTIFY_URL and users can
#   access the app. HTTP :80 redirects to HTTPS; HTTPS :443 proxies to
#   Docker staging (127.0.0.1:20080).
#
# BOTTLENECK / DESIGN:
#   SSL on host only; Docker stays HTTP. CSP allows reCAPTCHA and Cloudflare
#   Turnstile (challenges.cloudflare.com) for complaint/TT forms. Proxy
#   buffers avoid "upstream sent too big header" from Laravel.
#
# PREREQUISITES:
#   - dev.fixedservices.ethiotelecom.et reachable (e.g. /etc/hosts or DNS)
#   - Staging stack: docker compose -f compose.staging.yml -p fbb_staging up -d
#   - SSL cert: Let's Encrypt (certbot) OR self-signed (see STUDENT_TRAINING_MANUAL.md Ch. 6)
#
# SETUP:
#   1. Copy to host: sites-available + symlink to sites-enabled, OR /etc/nginx/conf.d/ (e.g. fbb.conf)
#   2. Set ssl_certificate and ssl_certificate_key (paths below or Let's Encrypt)
#   3. sudo nginx -t && sudo systemctl reload nginx
#
# Full deployment: docs/STUDENT_TRAINING_MANUAL.md (Chapters 5–6)
# ============================================================================

# HTTP — redirect to HTTPS (Telebirr notify callback must be HTTPS)
server {
    listen 80;
    server_name dev.fixedservices.ethiotelecom.et;
    location / {
        return 301 https://$host$request_uri;
    }
}

# HTTPS — SSL termination + proxy to staging Docker (port 20080)
server {
    listen 443 ssl;
    server_name dev.fixedservices.ethiotelecom.et;

    # Self-signed (default). For Let's Encrypt: /etc/letsencrypt/live/<domain>/fullchain.pem and privkey.pem
    ssl_certificate     /etc/nginx/ssl/selfsigned/dev.fixedservices.ethiotelecom.et.crt;
    ssl_certificate_key /etc/nginx/ssl/selfsigned/dev.fixedservices.ethiotelecom.et.key;

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers on;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384;
    # Large request headers (cookies, OAuth) — prevents 414/400
    large_client_header_buffers 4 64k;

    location / {
        # Proxy to Docker staging (compose.staging.yml maps container :80 to host :20080)
        proxy_pass http://127.0.0.1:20080;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffer_size 128k;
        proxy_buffers 4 256k;
        proxy_busy_buffers_size 256k;
        proxy_hide_header Content-Security-Policy;
        # CSP: reCAPTCHA (google, recaptcha.net) + Cloudflare Turnstile (challenges.cloudflare.com) for complaint/TT forms
        add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://cdn.jsdelivr.net https://maps.googleapis.com https://www.google.com https://www.gstatic.com https://www.recaptcha.net https://challenges.cloudflare.com; script-src-elem 'self' 'unsafe-inline' 'unsafe-eval' https://cdn.jsdelivr.net https://maps.googleapis.com https://www.google.com https://www.gstatic.com https://www.recaptcha.net https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: https: blob:; connect-src 'self' https: https://challenges.cloudflare.com; frame-src 'self' https://www.google.com https://www.recaptcha.net https://challenges.cloudflare.com; frame-ancestors 'self'; form-action 'self'; base-uri 'self'; object-src 'none';" always;
    }
}
