# ============================================================================
# Host Nginx — Staging on fixedservices.ethiotelecom.et:8443
# ============================================================================
#
# PURPOSE:
#   Expose staging on the same hostname as production but a different port
#   (8443). Uses the SAME SSL certificate as the main app (:443), so no
#   separate staging cert is needed. Proxies to Docker staging (127.0.0.1:20080).
#
# BOTTLENECK / DESIGN:
#   Single cert for both :443 (production) and :8443 (staging) simplifies
#   certificate management. Proxy buffers avoid large-header issues from Laravel.
#
# ACCESS: https://fixedservices.ethiotelecom.et:8443
#
# PREREQUISITES:
#   - Staging stack: docker compose -f compose.staging.yml -p fbb_staging up -d
#   - Copy to /etc/nginx/conf.d/ (e.g. fbb-staging-8443.conf)
#   - Set ssl_certificate and ssl_certificate_key to the SAME paths as your
#     main fixedservices.ethiotelecom.et server block
#   - sudo nginx -t && sudo systemctl reload nginx
#
# Full deployment: docs/STUDENT_TRAINING_MANUAL.md (Chapters 5–6)
# ============================================================================

# SSL and security headers mirror production (/etc/nginx/conf.d/fbb.conf)
server {
    listen 8443 ssl;
    server_name fixedservices.ethiotelecom.et;

    ssl_certificate /etc/nginx/ssl/telebirr-fullchain.crt;
    ssl_certificate_key /etc/nginx/ssl/telebirr.ethiotelecom.et.key;

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;

    # Security headers (same as production fbb.conf)
    add_header X-Content-Type-Options nosniff;
    add_header X-Frame-Options DENY;
    add_header X-XSS-Protection "1; mode=block";
    add_header Referrer-Policy "strict-origin-when-cross-origin";
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://cdn.jsdelivr.net https://www.gstatic.com https://www.recaptcha.net https://maps.googleapis.com https://challenges.cloudflare.com; script-src-elem 'self' 'unsafe-inline' 'unsafe-eval' https://cdn.jsdelivr.net https://maps.googleapis.com https://www.google.com https://www.gstatic.com https://www.recaptcha.net https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://maps.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https://maps.gstatic.com https://maps.googleapis.com *.googleapis.com; connect-src 'self' https://maps.googleapis.com https://challenges.cloudflare.com; frame-src 'self' https://www.recaptcha.net https://www.google.com https://challenges.cloudflare.com;" always;

    large_client_header_buffers 4 64k;

    location / {
        proxy_pass http://127.0.0.1:20080;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Port  8443;
        proxy_buffer_size 128k;
        proxy_buffers 4 256k;
        proxy_busy_buffers_size 256k;
        proxy_hide_header Content-Security-Policy;
    }
}
