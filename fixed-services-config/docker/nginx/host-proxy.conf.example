# ============================================================================
# Host Nginx — Fixed Service Request STAGING (minimal)
# ============================================================================
#
# PURPOSE:
#   Expose the staging app (Docker port 20080) over HTTPS so users and
#   Telebirr can reach it. SSL is terminated here; Docker receives HTTP only.
#
# BOTTLENECK / DESIGN:
#   SSL termination on the host avoids putting certificates in every container
#   and keeps cert renewal (e.g. certbot) in one place. Proxy buffers below
#   prevent "upstream sent too big header" when Laravel sends large responses.
#
# PREREQUISITES:
#   - Staging stack: docker compose -f compose.staging.yml -p fbb_staging up -d
#   - SSL cert and key at the paths set below (self-signed or Let's Encrypt)
#
# SETUP:
#   Copy to host: /etc/nginx/sites-available/ then symlink in sites-enabled,
#   OR /etc/nginx/conf.d/ (e.g. fbb-staging.conf).
#   Then: sudo nginx -t && sudo systemctl reload nginx
#
# Full deployment steps: docs/STUDENT_TRAINING_MANUAL.md (Chapters 5–6)
# ============================================================================

# HTTP — redirect to HTTPS (required for Telebirr notify callback; gateway expects HTTPS)
server {
    listen 80;
    server_name dev.fixedservices.ethiotelecom.et;
    location / {
        return 301 https://$host$request_uri;
    }
}

# HTTPS — SSL termination and reverse proxy to Docker staging (port 20080)
server {
    listen 443 ssl;
    server_name dev.fixedservices.ethiotelecom.et;

    # SSL: self-signed default paths. For Let's Encrypt use e.g.:
    #   /etc/letsencrypt/live/dev.fixedservices.ethiotelecom.et/fullchain.pem
    #   /etc/letsencrypt/live/dev.fixedservices.ethiotelecom.et/privkey.pem
    ssl_certificate     /etc/nginx/ssl/selfsigned/dev.fixedservices.ethiotelecom.et.crt;
    ssl_certificate_key /etc/nginx/ssl/selfsigned/dev.fixedservices.ethiotelecom.et.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers on;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384;

    # Large headers (cookies, OAuth) — prevents 414/400 from long request headers
    large_client_header_buffers 4 64k;

    location / {
        proxy_pass http://127.0.0.1:20080;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Buffers: avoid "upstream sent too big header" (Filament/Livewire, large Set-Cookie)
        proxy_buffer_size 128k;
        proxy_buffers 4 256k;
        proxy_busy_buffers_size 256k;
        # CSP: allow reCAPTCHA and Cloudflare Turnstile for forms
        proxy_hide_header Content-Security-Policy;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://cdn.jsdelivr.net https://maps.googleapis.com https://www.google.com https://www.gstatic.com https://www.recaptcha.net https://challenges.cloudflare.com; script-src-elem 'self' 'unsafe-inline' 'unsafe-eval' https://cdn.jsdelivr.net https://maps.googleapis.com https://www.google.com https://www.gstatic.com https://www.recaptcha.net https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: https: blob:; connect-src 'self' https: https://challenges.cloudflare.com; frame-src 'self' https://www.google.com https://www.recaptcha.net https://challenges.cloudflare.com; frame-ancestors 'self'; form-action 'self'; base-uri 'self'; object-src 'none';" always;
    }
}
