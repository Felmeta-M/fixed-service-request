{
    "preset": "laravel",
    "rules": {
        "blank_line_before_statement": {
            "statements": [
                "return",
                "if",
                "for",
                "foreach",
                "while",
                "do",
                "switch",
                "try"
            ]
        },
        "single_blank_line_at_eof": true,
        "no_extra_blank_lines": true,
        "binary_operator_spaces": {
            "default": "align"
        }
    }
}